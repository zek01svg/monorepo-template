{
  "name": "@repo/service-discovery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "build": "pnpm with-env tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules coverage.json",
    "dev": "pnpm with-env tsc --watch",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint --type-aware -c ../../tooling/eslint/oxlint.json",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "typescript": "catalog:"
  },
  "prettier": "@repo/prettier-config",
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8"
  }
}
