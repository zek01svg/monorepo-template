{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "importOrder": [
    "<TYPES>",
    "^(react/(.*)$)|^(react$)|^(react-native(.*)$)",
    "^(next/(.*)$)|^(next$)",
    "^(expo(.*)$)|^(expo$)",
    "<THIRD_PARTY_MODULES>",
    "",
    "<TYPES>^@repo",
    "^@repo/(.*)$",
    "",
    "<TYPES>^[.|..|~]",
    "^~/",
    "^[../]",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "4.4.0",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.gen.ts",
    "**/*.hbs",
    "Dockerfile",
    "dist",
    ".cache",
    "pnpm-lock.yaml"
  ]
}
